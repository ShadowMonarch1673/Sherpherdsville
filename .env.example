# Local development works with SQLite when DATABASE_URL and DB_NAME are omitted.
DEBUG=True
SECRET_KEY=replace-this-with-a-long-random-value
ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=

# Production database (recommended). Example:
# DATABASE_URL=postgresql://user:password@host:5432/database
DATABASE_URL=

# Optional separate resident registry database. If omitted, the local
# ResidentRegistry table is used and can be populated with seed_demo/admin.
EXTERNAL_DATABASE_URL=
EXTERNAL_RESIDENTS_TABLE=residents
EXTERNAL_EMAIL_COLUMN=email
EXTERNAL_FIRST_NAME_COLUMN=first_name
EXTERNAL_LAST_NAME_COLUMN=last_name
EXTERNAL_ROOM_COLUMN=room_number

# Email: leave BREVO_API_KEY empty to use Django's configured backend.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@example.com
BREVO_API_KEY=
BREVO_SENDER_EMAIL=noreply@example.com

# Only enable this locally. Production must keep it False.
OTP_DEBUG_RETURN_CODE=True

# Optional Google OAuth.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
FRONTEND_URL=http://localhost:5173
